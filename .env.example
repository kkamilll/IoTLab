# Server Port
PORT=3500

# MongoDB Connection String
# 1. Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/iotlab_db
# 2. Remote Server with Auth:
# MONGO_URI=mongodb://user:password@remote_server_ip:27017/iotlab_db?authSource=admin
# 3. MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://user:password@cluster0.abcde.mongodb.net/iotlab_db?retryWrites=true&w=majority

# JWT Secret for session authentication
JWT_SECRET=iotlab_super_secret_jwt_key_2026

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_SERVICE=gmail
SMTP_PORT=587
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Optional: Google reCAPTCHA v2
# VITE_RECAPTCHA_PUBLIC_KEY=your_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
